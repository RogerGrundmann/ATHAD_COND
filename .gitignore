# Compiled artifacts
*.o
*.d
*.a
*.so
*.so.*

# Python build artifacts
*.pyc
__pycache__/
*.egg-info/
build/
dist/
python/build/

# Cython generated C++
python/pycond.cpp
python/pycond.h

# NOTE: the param.py-generated bindings (atmosphere/*.inc, python/atmosphere_pxd.pxi,
# python/pycond.pyx, cli+python/config_cond.xml) are deliberately TRACKED, as in the
# parent repo — a param.py change then shows its full effect in the diff.

# Simulation output data. The pattern is output_*/ rather than output_Hadean*/
# because an experiment directory named anything else sits untracked-but-not-ignored
# and is swept into the next `git add -A` -- which is exactly how 186 MB of VTK once
# got committed and pushed here. Nothing tracked lives inside an output directory.
# Same widening as ATHAD's 3575d7a.
output_*/
python/output_*/
cli/output_*/
atm_log.txt
atom_log.txt

# Console logs of individual runs. atom_log.txt is RESERVED — the model opens it
# itself and truncates it, so a shell redirect to that name destroys the run's
# output; redirect to run_<something>.log instead.
run_*.log

# One-off configs for a particular run length or experiment. The generated
# config_cond.xml in cli/ and python/ stays tracked; these variants do not.
config_cond_*.xml

# Executables
cli/cond
test/rad_selftest

# Reference papers (copyright)
Reaction_Papers/

# ODT and PDF documents
*.odt
*.pdf

# Claude Code session data
.claude/
